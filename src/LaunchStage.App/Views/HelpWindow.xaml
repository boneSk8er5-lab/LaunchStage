<Window x:Class="LaunchStageApp.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchStage help"
        Width="1040" Height="760" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/LaunchStage.ico"
        Style="{StaticResource DarkWindow}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Topics -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Help" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search the guide" />
                <TextBlock x:Name="SearchPlaceholder" Text="Search, like hotkey or browser" IsHitTestVisible="False"
                           Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Content="Getting started tour" Margin="0,0,0,8" Click="Tour_Click"
                        ToolTip="The short walkthrough shown the first time LaunchStage opens" />
                <Button Content="Open as web page" Click="WebPage_Click"
                        ToolTip="Opens the whole guide in your browser, where you can print it or save it as a PDF" />
                <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" Margin="0,12,0,4" />
                <Button Content="License" HorizontalAlignment="Left" Padding="10,3" Click="License_Click"
                        ToolTip="Who may use LaunchStage, and how" />
            </StackPanel>
            <ListBox x:Name="TopicsList" SelectionChanged="Topics_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The topic -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="28,22,12,22">
            <FlowDocumentScrollViewer x:Name="Reader" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" />
        </Border>
    </Grid>
</Window>
