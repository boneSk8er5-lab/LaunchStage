<Window x:Class="LaunchStageApp.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private profile"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DarkWindow}">

    <StackPanel Margin="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ActionText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <PasswordBox x:Name="PinBox" Margin="0,16,0,0" MaxLength="4" FontSize="20" HorizontalContentAlignment="Center"
                     PreviewTextInput="PinBox_PreviewTextInput" PasswordChanged="PinBox_PasswordChanged" />
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="Unlock_Click" />
        </StackPanel>
    </StackPanel>
</Window>
