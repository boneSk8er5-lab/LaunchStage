<Window x:Class="LaunchStageApp.Views.ProfileEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit profile"
        Width="1240" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DarkWindow}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Help" Tag="move-windows" Margin="0,0,8,0" Click="Help_Click"
                        ToolTip="How to move windows, add apps and more" />
                <Button Content="Stream Deck commands..." Margin="0,0,8,0" Click="Commands_Click" />
                <Button Content="Name, look &amp; options..." Click="ProfileSettings_Click"
                        ToolTip="Name, icon, color, what happens to other apps, private PIN, and re-picking windows" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Drag a window box to move it, drag its bottom-right corner to resize. Arrow keys nudge the selected box (Shift = 10 px). Hold Alt while dragging to stop snapping." />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <!-- Monitor preview -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                        <Button DockPanel.Dock="Right" Content="Arrange open windows now" Click="ArrangeNow_Click"
                                ToolTip="Move the windows that are open right now to these spots, without opening or closing anything" />
                        <CheckBox x:Name="SnapBox" Content="Snap to screen edges and halves" IsChecked="True"
                                  VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" ClipToBounds="True">
                        <Canvas x:Name="Board" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                                SizeChanged="Board_SizeChanged"
                                MouseLeftButtonDown="Board_MouseLeftButtonDown" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- Apps and settings -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="+ Open window" Padding="8,3" Margin="0,0,6,0" Click="AddWindow_Click"
                                        ToolTip="Add one of the windows that are open right now" />
                                <Button Content="+ Program" Padding="8,3" Click="AddProgram_Click"
                                        ToolTip="Add a program, shortcut or game by its file" />
                            </StackPanel>
                            <TextBlock Text="Apps (in opening order)" Style="{StaticResource SectionTitle}" Margin="0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox x:Name="AppsList" Height="190" SelectionChanged="AppsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="UpButton" Content="Move up" Padding="8,3" Margin="0,0,6,0" Click="MoveUp_Click" />
                            <Button x:Name="DownButton" Content="Move down" Padding="8,3" Margin="0,0,6,0" Click="MoveDown_Click" />
                            <Button x:Name="RemoveButton" Content="Remove" Padding="8,3" Style="{StaticResource DangerButton}"
                                    Click="Remove_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <TextBlock x:Name="NoSelectionText" Style="{StaticResource Hint}" TextAlignment="Center"
                                   VerticalAlignment="Center" Text="Pick an app in the list or a box on the screens." />

                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Name" Style="{StaticResource SectionTitle}" />
                                <TextBox x:Name="AppNameBox" TextChanged="AppName_Changed" Margin="0,0,0,10" />

                                <TextBlock Text="Program, shortcut or link" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Padding="8,3" Click="Browse_Click" />
                                    <TextBox x:Name="PathBox" TextChanged="Path_Changed" />
                                </DockPanel>
                                <TextBlock Text="Arguments (optional)" Style="{StaticResource Hint}" Margin="0,0,0,3" />
                                <TextBox x:Name="ArgumentsBox" TextChanged="Arguments_Changed" Margin="0,0,0,10" />

                                <StackPanel x:Name="WebsitesPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Websites" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" /><Button Style="{StaticResource HelpLink}" Tag="browsers" Click="Help_Click" /></StackPanel>
                                    <TextBox x:Name="WebsitesBox" TextChanged="Websites_Changed" AcceptsReturn="True"
                                             TextWrapping="NoWrap" MinHeight="64" MaxHeight="140"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,6" TextWrapping="Wrap"
                                               Text="One per line; each opens as a tab in this window. Leave it empty to let the browser show its usual start pages." />
                                    <Button Content="Use the site it's showing now" Padding="8,3" HorizontalAlignment="Left"
                                            Click="ReadWebsite_Click"
                                            ToolTip="Read the website this browser window is showing right now" />
                                </StackPanel>

                                <TextBlock Text="What LaunchStage does with it" Style="{StaticResource SectionTitle}" />
                                <RadioButton x:Name="BehaviorBoth" GroupName="Behavior" Content="Open it if needed, then put it in place"
                                             Margin="0,0,0,4" Checked="Behavior_Checked" />
                                <RadioButton x:Name="BehaviorPosition" GroupName="Behavior" Content="Only put it in place if it's already open"
                                             Margin="0,0,0,4" Checked="Behavior_Checked" />
                                <RadioButton x:Name="BehaviorLaunch" GroupName="Behavior" Content="Only open it (don't move it)"
                                             Margin="0,0,0,10" Checked="Behavior_Checked" />

                                <StackPanel x:Name="PositionPanel">
                                    <TextBlock Text="Monitor" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel x:Name="MonitorPanel" Margin="0,0,0,6" />

                                    <TextBlock Text="Window" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel Margin="0,0,0,6">
                                        <RadioButton x:Name="StateNormal" GroupName="State" Content="Normal" Margin="0,0,16,4" Checked="State_Checked" />
                                        <RadioButton x:Name="StateMax" GroupName="State" Content="Maximized" Margin="0,0,16,4" Checked="State_Checked" />
                                        <RadioButton x:Name="StateMin" GroupName="State" Content="Minimized" Margin="0,0,0,4" Checked="State_Checked" />
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Left" Style="{StaticResource Hint}" />
                                            <TextBox x:Name="XBox" TextChanged="Number_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Top" Style="{StaticResource Hint}" />
                                            <TextBox x:Name="YBox" TextChanged="Number_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Width" Style="{StaticResource Hint}" />
                                            <TextBox x:Name="WBox" TextChanged="Number_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Height" Style="{StaticResource Hint}" />
                                            <TextBox x:Name="HBox" TextChanged="Number_Changed" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                               Text="Left and Top are measured from the monitor's top-left corner, in pixels." />
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="Use its current spot" Padding="8,3" Margin="0,0,6,6" Click="UseCurrent_Click"
                                                ToolTip="Copy where this app's window is right now" />
                                        <Button Content="Move it there now" Padding="8,3" Margin="0,0,6,6" Click="MoveNow_Click"
                                                ToolTip="Move this app's open window to this spot, to see how it looks" />
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock Text="Options" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="AdminBox" Content="Run as administrator" Margin="0,0,0,6" Click="Options_Click" />
                                <CheckBox x:Name="CloseBox" Content="Close it when the profile is closed" Margin="0,0,0,6" Click="Options_Click" />
                                <CheckBox x:Name="PrivateBox" Content="Open as a private / incognito window" Margin="0,0,0,6"
                                          Click="Options_Click" Visibility="Collapsed" />

                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Wait before opening (seconds)" Style="{StaticResource Hint}" />
                                        <TextBox x:Name="DelayBox" TextChanged="Timing_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Give up waiting after (seconds)" Style="{StaticResource Hint}" />
                                        <TextBox x:Name="TimeoutBox" TextChanged="Timing_Changed" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Matching (advanced)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Process name (without .exe)" Style="{StaticResource Hint}" Margin="0,0,0,3" />
                                <TextBox x:Name="ProcessBox" TextChanged="Matching_Changed" Margin="0,0,0,6" />
                                <TextBlock Text="Only windows whose title contains (optional)" Style="{StaticResource Hint}" Margin="0,0,0,3" />
                                <TextBox x:Name="TitleContainsBox" TextChanged="Matching_Changed" Margin="0,0,0,6" />
                                <TextBlock x:Name="CapturedTitleText" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save profile" Style="{StaticResource AccentButton}" Click="Save_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
