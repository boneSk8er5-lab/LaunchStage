<Window x:Class="LaunchStageApp.Views.StatusPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchStage"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">

    <Border Margin="8" Padding="16" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- Shown when an app stays open after being asked to close -->
            <StackPanel x:Name="ClosePrompt" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ClosePromptText" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarnBrush}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Try again" Margin="0,0,6,6" Click="TryAgain_Click" />
                    <Button Content="Leave it open &amp; continue" Margin="0,0,6,6" Click="LeaveOpen_Click" />
                    <Button Content="Stop profile" Style="{StaticResource DangerButton}" Margin="0,0,6,6" Click="Stop_Click" />
                </WrapPanel>
            </StackPanel>

            <StackPanel x:Name="Messages" Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel x:Name="FinishButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,10,0,0" Visibility="Collapsed">
                <Button Content="Open log" Margin="0,0,6,0" Click="OpenLog_Click" />
                <Button Content="Close" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
