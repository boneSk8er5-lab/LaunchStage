<Window x:Class="LaunchStageApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchStage"
        Width="820" Height="540" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/LaunchStage.ico"
        Style="{StaticResource DarkWindow}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!--
            Four layouts (Settings > Look, or the buttons in the header): Cards, SmallCards, List and Tiles.
            Each has a template for a profile ("Card_<layout>") and for the dashed new-profile button
            ("New_<layout>"); MainWindow.LayoutSelector picks them. All layouts share the right-click menu below.
        -->
        <ContextMenu x:Key="CardMenu" x:Shared="False">
            <MenuItem Header="Activate" FontWeight="SemiBold" Click="CardActivate_Click" />
            <MenuItem Header="Close profile" Click="CardCloseProfile_Click" />
            <MenuItem Header="Put windows back" Click="CardResnap_Click" />
            <MenuItem Header="Edit layout &amp; apps..." Click="CardEdit_Click" />
            <MenuItem Header="Name, look &amp; options..." Click="CardSettings_Click" />
            <MenuItem Header="Duplicate" Click="CardDuplicate_Click" />
            <MenuItem Header="Stream Deck commands..." Click="CardCommands_Click" />
            <MenuItem Header="{Binding FavoriteMenuText}" Click="CardFavorite_Click" />
            <MenuItem Header="Export..." Click="CardExport_Click" />
            <MenuItem Header="Delete" Foreground="{DynamicResource DangerTextBrush}" Click="CardDelete_Click" />
        </ContextMenu>

        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackItems">
            <StackPanel />
        </ItemsPanelTemplate>

        <!-- ============ Cards (the original look) ============ -->
        <DataTemplate x:Key="Card_Cards">
            <Border x:Name="CardBorder" Width="200" Height="128" Margin="0,0,12,12" Padding="0"
                    Style="{StaticResource Card}" Cursor="Hand" ContextMenu="{DynamicResource CardMenu}"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{Binding ColorBrush}" CornerRadius="7,7,0,0" />
                    <Grid Grid.Row="1" Margin="14,10,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Right" Text="★" FontSize="16" ToolTip="Favorite"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding FavoriteVisibility}" />
                            <TextBlock DockPanel.Dock="Right" Text="&#xE72E;" FontSize="15" Margin="0,2,8,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="Private: needs a PIN"
                                       Visibility="{Binding LockVisibility}" />
                            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource InputBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="18"
                                           Foreground="{Binding ColorBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="0,8,0,2" />
                        <TextBlock Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource Hint}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="New_Cards">
            <Button Width="200" Height="128" Margin="0,0,12,12"
                    Style="{StaticResource NewCardButton}" Click="NewProfile_Click">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="New profile" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="from the windows open now" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ============ Small cards: icon and name only ============ -->
        <DataTemplate x:Key="Card_SmallCards">
            <Border x:Name="CardBorder" Width="170" Height="56" Margin="0,0,10,10" Padding="0"
                    Style="{StaticResource Card}" Cursor="Hand" ContextMenu="{DynamicResource CardMenu}"
                    ToolTip="{Binding Summary}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="5" Background="{Binding ColorBrush}" CornerRadius="7,0,0,7" />
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="10,0,8,0"
                            Background="{DynamicResource InputBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="14"
                                   Foreground="{Binding ColorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="★" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" Visibility="{Binding FavoriteVisibility}" />
                    <TextBlock DockPanel.Dock="Right" Text="&#xE72E;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding LockVisibility}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="New_SmallCards">
            <Button Width="170" Height="56" Margin="0,0,10,10"
                    Style="{StaticResource NewCardButton}" Click="NewProfile_Click"
                    ToolTip="Make a profile from the windows open now">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="20" Margin="0,0,8,2" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="New profile" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ============ List: one row per profile ============ -->
        <DataTemplate x:Key="Card_List">
            <Border x:Name="CardBorder" Height="48" Margin="0,0,0,8" Padding="0"
                    Style="{StaticResource Card}" Cursor="Hand" ContextMenu="{DynamicResource CardMenu}"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="5" Background="{Binding ColorBrush}" CornerRadius="7,0,0,7" />
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Margin="12,0,12,0"
                            Background="{DynamicResource InputBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="15"
                                   Foreground="{Binding ColorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="★" FontSize="14" Margin="0,0,14,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" Visibility="{Binding FavoriteVisibility}" ToolTip="Favorite" />
                    <TextBlock DockPanel.Dock="Right" Text="&#xE72E;" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Private: needs a PIN"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding LockVisibility}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Hint}"
                               TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0,14,0" />
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="New_List">
            <Button Height="48" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                    Style="{StaticResource NewCardButton}" Click="NewProfile_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="20" Margin="0,0,10,2" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="New profile" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  from the windows open now" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ============ Big tiles: large icon and name, easy to hit ============ -->
        <DataTemplate x:Key="Card_Tiles">
            <Border x:Name="CardBorder" Width="168" Height="168" Margin="0,0,12,12" Padding="0"
                    Style="{StaticResource Card}" Cursor="Hand" ContextMenu="{DynamicResource CardMenu}"
                    ToolTip="{Binding Summary}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{Binding ColorBrush}" CornerRadius="7,7,0,0" />
                    <Grid Grid.Row="1" Margin="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE72E;" FontSize="13" Margin="0,2,6,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding LockVisibility}" />
                            <TextBlock Text="★" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding FavoriteVisibility}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource InputBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="32"
                                           Foreground="{Binding ColorBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="146" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="New_Tiles">
            <Button Width="168" Height="168" Margin="0,0,12,12"
                    Style="{StaticResource NewCardButton}" Click="NewProfile_Click">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="New profile" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="from the windows open now" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Quick layout switch -->
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <RadioButton x:Name="LayoutCardsButton" Tag="Cards" GroupName="Layout" ToolTip="Cards"
                                 Style="{StaticResource IconTile}" Width="30" Height="30" Margin="0,0,4,0" Checked="Layout_Checked">
                        <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </RadioButton>
                    <RadioButton x:Name="LayoutSmallButton" Tag="SmallCards" GroupName="Layout" ToolTip="Small cards"
                                 Style="{StaticResource IconTile}" Width="30" Height="30" Margin="0,0,4,0" Checked="Layout_Checked">
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </RadioButton>
                    <RadioButton x:Name="LayoutListButton" Tag="List" GroupName="Layout" ToolTip="List"
                                 Style="{StaticResource IconTile}" Width="30" Height="30" Margin="0,0,4,0" Checked="Layout_Checked">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </RadioButton>
                    <RadioButton x:Name="LayoutTilesButton" Tag="Tiles" GroupName="Layout" ToolTip="Big tiles"
                                 Style="{StaticResource IconTile}" Width="30" Height="30" Margin="0" Checked="Layout_Checked">
                        <TextBlock Text="&#xE739;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </RadioButton>
                </StackPanel>
                <CheckBox x:Name="ColorBlindToggle" Content="Red-green vision assist" Margin="0,0,14,0"
                          Checked="ColorBlindToggle_Changed" Unchecked="ColorBlindToggle_Changed" />
                <Button Content="Help" Margin="0,0,8,0" Click="Help_Click" ToolTip="How everything works (F1)" />
                <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="LaunchStage" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Double-click a profile to open it. Right-click it for more." Style="{StaticResource Hint}" />
            </StackPanel>
        </DockPanel>

        <!-- Profiles (layout chosen in code: ApplyLayout) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProfilesList" ItemsPanel="{StaticResource WrapItems}" />
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close App" Style="{StaticResource DangerButton}" Click="CloseApp_Click"
                    ToolTip="Exit LaunchStage completely (closing the window keeps it in the tray)" />
            <Button x:Name="ImportButton" DockPanel.Dock="Left" Content="Import profile..." Click="Import_Click" />
            <TextBlock x:Name="CopyrightText" DockPanel.Dock="Right" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                       VerticalAlignment="Center" Margin="12,0,14,0" Cursor="Hand"
                       ToolTip="Click to read the license" MouseLeftButtonUp="Copyright_Click" />
            <TextBlock x:Name="BusyText" Text="Setting up your workspace..." Margin="12,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
