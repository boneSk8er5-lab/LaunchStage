<Window x:Class="LaunchStageApp.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to LaunchStage"
        Width="780" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/LaunchStage.ico"
        Style="{StaticResource DarkWindow}">

    <DockPanel Margin="24,20,24,20">
        <!-- Buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip" Click="Skip_Click"
                    ToolTip="Close this. You can open it again from Help." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="Back" Margin="0,0,8,0" Click="Back_Click" />
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButton}" IsDefault="True" Click="Next_Click" />
            </StackPanel>
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>

        <!-- The page -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="StepText" Style="{StaticResource Hint}" Margin="0,0,0,4" />
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock x:Name="BodyText" FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16" />
        </StackPanel>
        <Border x:Name="PictureFrame" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource PanelBorderBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Top">
            <Image x:Name="Picture" Stretch="Uniform" StretchDirection="DownOnly" />
        </Border>
    </DockPanel>
</Window>
