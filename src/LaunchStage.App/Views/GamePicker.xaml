<Window x:Class="LaunchStageApp.Views.GamePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a game"
        Width="520" Height="600" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Style="{StaticResource DarkWindow}">

    <DockPanel Margin="18">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Pick a game" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Text="Double-click a game to start it." />
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="SearchBox" Margin="0,12,0,0" TextChanged="Search_Changed" ToolTip="Search your games" />
        </StackPanel>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                       Foreground="{DynamicResource WarnBrush}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="+ Add game..." Margin="0,0,10,0" Click="AddGame_Click"
                            ToolTip="Add a game that isn't from Steam or Epic, by its .exe or shortcut" />
                    <CheckBox x:Name="ShowHiddenBox" Content="Show hidden" VerticalAlignment="Center"
                              Checked="ShowHidden_Changed" Unchecked="ShowHidden_Changed" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Not now" IsCancel="True" Margin="0,0,8,0" Click="NotNow_Click" />
                    <Button x:Name="PlayButton" Content="Play" Style="{StaticResource AccentButton}" IsDefault="True"
                            Click="Play_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Games -->
        <Grid>
            <ListBox x:Name="GamesList" MouseDoubleClick="GamesList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <TextBlock DockPanel.Dock="Right" Text="★" FontSize="14" Margin="8,0,2,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" Visibility="{Binding StarVisibility}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Opacity="{Binding NameOpacity}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="FavoriteItem" Header="Add to favorites" Click="Favorite_Click" />
                        <MenuItem x:Name="HideItem" Header="Hide from this list" Click="Hide_Click" />
                        <MenuItem x:Name="RemoveItem" Header="Remove" Click="Remove_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" TextAlignment="Center" VerticalAlignment="Center"
                       Margin="20" Visibility="Collapsed"
                       Text="Looking for your games..." />
        </Grid>
    </DockPanel>
</Window>
