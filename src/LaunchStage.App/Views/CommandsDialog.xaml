<Window x:Class="LaunchStageApp.Views.CommandsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Deck commands"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DarkWindow}">

    <StackPanel Margin="18">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                   Text="Paste one of these as the location of a new Windows shortcut (right-click the desktop, New, Shortcut), then pick that shortcut in Stream Deck's System &gt; Open action. Stream Deck's Open action can also take the full line directly." />

        <TextBlock Text="Open this profile" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="14,4" Click="CopyActivate_Click" />
            <TextBox x:Name="ActivateBox" IsReadOnly="True" FontFamily="Consolas" />
        </DockPanel>

        <TextBlock Text="Open or close this profile (one button for both)" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="14,4" Click="CopyToggle_Click" />
            <TextBox x:Name="ToggleBox" IsReadOnly="True" FontFamily="Consolas" />
        </DockPanel>

        <TextBlock Text="Close this profile" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="14,4" Click="CopyClose_Click" />
            <TextBox x:Name="CloseBox" IsReadOnly="True" FontFamily="Consolas" />
        </DockPanel>

        <TextBlock Text="Put its windows back in place" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="14,4" Click="CopyResnap_Click" />
            <TextBox x:Name="ResnapBox" IsReadOnly="True" FontFamily="Consolas" />
        </DockPanel>

        <TextBlock Text="Open the game picker (any profile)" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="14,4" Click="CopyGames_Click" />
            <TextBox x:Name="GamesBox" IsReadOnly="True" FontFamily="Consolas" />
        </DockPanel>

        <TextBlock Text="LaunchStage program" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="14,4" Click="CopyPath_Click" />
            <TextBox x:Name="PathBox" IsReadOnly="True" FontFamily="Consolas" />
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="For tools that ask for the program and its arguments separately: use this as the program, and --activate &quot;name&quot;, --toggle &quot;name&quot;, --close &quot;name&quot;, --resnap &quot;name&quot; or --games as the arguments. Works with any macro pad that can open a program (Stream Deck, Soomfon and others)." />

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" />
            <TextBlock x:Name="CopiedText" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</Window>
